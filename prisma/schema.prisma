generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  CONTENT_MANAGER
  TEACHER
  STUDENT
  PARENT
}

enum ApplicationStatus {
  NEW
  IN_PROGRESS
  NO_ANSWER
  INTERESTED
  TRIAL_SCHEDULED
  ENROLLED
  REJECTED
}

enum ApplicationActivityType {
  COMMENT
  STATUS_CHANGE
  CALLBACK
  ASSIGNMENT
}

enum ApplicationSource {
  WEBSITE
  ADVERTISEMENT
  INSTAGRAM
  TELEGRAM
  PHONE_CALL
  WALK_IN
  REFERRAL
  OTHER
}

enum Gender {
  MALE
  FEMALE
}

enum LessonType {
  REGULAR
  PRACTICE
  CONTROL
  TEST
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  REJECTED
}

enum NotificationChannel {
  IN_APP
  TELEGRAM
}

enum NotificationType {
  PAYMENT
  HOMEWORK
  ATTENDANCE
  ACHIEVEMENT
  ANNOUNCEMENT
  LESSON_REMINDER
  GRADE
  SALARY
}

enum AchievementType {
  MONTHLY
  SPECIAL
}

model User {
  id             String   @id @default(cuid())
  phone          String   @unique
  fullName       String?
  passwordHash   String
  role           Role
  isActive       Boolean  @default(true)
  telegramChatId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student               Student?
  teacher               Teacher?
  parent                Parent?
  notifications         Notification[]
  auditLogs             AuditLog[]
  refreshTokens         RefreshToken[]
  announcements         Announcement[]         @relation("AnnouncementAuthor")
  announcementReads     AnnouncementRead[]
  assignedApplications  AdmissionApplication[] @relation("ApplicationAssignee")
  applicationActivities ApplicationActivity[]  @relation("ApplicationActivityActor")
  devicePushTokens      DevicePushToken[]
}

model SiteContent {
  id            String    @id @default(cuid())
  key           String    @unique
  draft         Json
  published     Json?
  updatedById   String?
  publishedById String?
  publishedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  revisions SiteContentRevision[]
}

model SiteContentRevision {
  id        String      @id @default(cuid())
  contentId String
  content   SiteContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  snapshot  Json
  action    String
  actorId   String
  createdAt DateTime    @default(now())

  @@index([contentId, createdAt])
}

model ReviewSubmission {
  id           String   @id @default(cuid())
  fullName     String
  phone        String?
  authorRole   String
  rating       Int
  text         String
  imageUrl     String?
  videoUrl     String?
  consent      Boolean  @default(false)
  status       String   @default("PENDING")
  isVerified   Boolean  @default(false)
  reviewedById String?
  reviewedAt   DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status, createdAt])
  @@index([phone])
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model Student {
  id         String    @id @default(cuid())
  userId     String    @unique
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName   String
  phone      String?
  birthDate  DateTime?
  gender     Gender
  enrolledAt DateTime  @default(now())
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  groups       StudentGroup[]
  parents      ParentStudent[]
  attendances  Attendance[]
  grades       Grade[]
  payments     Payment[]
  achievements Achievement[]
}

// Many-to-many between students and groups, with a per-link monthly fee
// override. The student's expected monthly tuition is the sum of
// `monthlyFee` across all of their StudentGroup rows. Unlinking a student
// from a group hard-deletes the row; historical attendance/grades survive
// because they reference the student/group ids directly.
model StudentGroup {
  id         String   @id @default(cuid())
  studentId  String
  groupId    String
  monthlyFee Decimal  @default(0) @db.Decimal(10, 2)
  joinedAt   DateTime @default(now())

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)
  group   Group   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([studentId, groupId])
  @@index([studentId])
  @@index([groupId])
}

model Parent {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName  String
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students ParentStudent[]
}

// Many-to-many link between parents and students.
// One parent may have multiple children; one student may have multiple
// parents (e.g. mother + father with separate logins).
model ParentStudent {
  parentId  String
  studentId String
  createdAt DateTime @default(now())

  parent  Parent  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@id([parentId, studentId])
  @@index([studentId])
}

model Teacher {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName       String
  phone          String?
  ratePerStudent Decimal  @default(0) @db.Decimal(10, 2)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  groups       Group[]
  homeworks    Homework[]
  lessonTopics LessonTopic[]
}

model Group {
  id                String    @id @default(cuid())
  name              String
  teacherId         String
  teacher           Teacher   @relation(fields: [teacherId], references: [id])
  maxStudents       Int       @default(20)
  schedule          Json
  // Suggested monthly fee for new students enrolled into this group; admin
  // can still override per-student in the StudentGroup link.
  defaultMonthlyFee Decimal   @default(0) @db.Decimal(10, 2)
  isActive          Boolean   @default(true)
  isRatingVisible   Boolean   @default(false)
  archivedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  students                   StudentGroup[]
  attendances                Attendance[]
  grades                     Grade[]
  homeworks                  Homework[]
  lessonTopics               LessonTopic[]
  announcements              Announcement[]
  attendanceReminderSessions AttendanceReminderSession[]
}

model Attendance {
  id         String           @id @default(cuid())
  date       DateTime
  studentId  String
  student    Student          @relation(fields: [studentId], references: [id])
  groupId    String
  group      Group            @relation(fields: [groupId], references: [id])
  lessonType LessonType       @default(REGULAR)
  status     AttendanceStatus @default(PRESENT)
  editedAt   DateTime?
  editReason String?
  createdAt  DateTime         @default(now())

  @@unique([studentId, groupId, date])
}

// Persistent state for attendance reminders. The student list is captured
// when the lesson becomes due, so a reminder cannot be closed by marking only
// one student (or by later removing an unmarked student from the group).
model AttendanceReminderSession {
  id                 String    @id @default(cuid())
  groupId            String
  group              Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  scheduledStart     DateTime
  scheduledEnd       DateTime
  expectedStudentIds String[]
  nextReminderAt     DateTime
  lastReminderAt     DateTime?
  completedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@unique([groupId, scheduledStart])
  @@index([completedAt, nextReminderAt])
}

model Grade {
  id         String     @id @default(cuid())
  date       DateTime
  studentId  String
  student    Student    @relation(fields: [studentId], references: [id])
  groupId    String
  group      Group      @relation(fields: [groupId], references: [id])
  lessonType LessonType
  score      Decimal    @db.Decimal(5, 2)
  maxScore   Decimal    @default(100) @db.Decimal(5, 2)
  comment    String?
  gradedAt   DateTime   @default(now())
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Payment {
  id              String        @id @default(cuid())
  studentId       String
  student         Student       @relation(fields: [studentId], references: [id])
  amount          Decimal       @db.Decimal(10, 2)
  status          PaymentStatus @default(PENDING)
  receiptUrl      String?
  nextPaymentDate DateTime?
  confirmedAt     DateTime?
  rejectedAt      DateTime?
  rejectReason    String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model Homework {
  id         String    @id @default(cuid())
  groupId    String
  group      Group     @relation(fields: [groupId], references: [id])
  teacherId  String
  teacher    Teacher   @relation(fields: [teacherId], references: [id])
  text       String
  imageUrls  String[]  @default([])
  youtubeUrl String?
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model LessonTopic {
  id        String   @id @default(cuid())
  date      DateTime
  groupId   String
  group     Group    @relation(fields: [groupId], references: [id])
  teacherId String
  teacher   Teacher  @relation(fields: [teacherId], references: [id])
  topic     String
  materials Json?
  createdAt DateTime @default(now())
}

model Achievement {
  id          String          @id @default(cuid())
  studentId   String
  student     Student         @relation(fields: [studentId], references: [id])
  type        AchievementType
  month       Int?
  year        Int?
  place       Int?
  title       String
  icon        String
  description String
  createdAt   DateTime        @default(now())

  @@unique([studentId, type, month, year])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  message   String
  data      Json?
  isRead    Boolean             @default(false)
  channel   NotificationChannel @default(IN_APP)
  createdAt DateTime            @default(now())
}

model DevicePushToken {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token       String   @unique
  deviceId    String
  platform    String
  appVersion  String?
  isActive    Boolean  @default(true)
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, deviceId])
  @@index([userId, isActive])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  action    String
  entity    String
  entityId  String?
  details   Json?
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(cuid())
  title     String
  message   String   @db.Text
  authorId  String
  author    User     @relation("AnnouncementAuthor", fields: [authorId], references: [id])
  groupId   String?
  group     Group?   @relation(fields: [groupId], references: [id])
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reads AnnouncementRead[]

  @@index([groupId, createdAt])
}

model AnnouncementRead {
  id             String       @id @default(cuid())
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime     @default(now())

  @@unique([announcementId, userId])
  @@index([userId])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  label     String?
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// Operating expenses recorded by admins/super-admins (paper, water,
// utilities, supplies, etc.). Kept independent from the per-student
// `Payment` flow so it doesn't pollute revenue analytics — surfaced on a
// dedicated /admin/expenses page only.
model Expense {
  id          String   @id @default(cuid())
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  description String?
  receiptUrl  String?
  spentAt     DateTime
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([spentAt])
  @@index([category])
}

// Public admission requests submitted from the marketing landing page.
// Kept separate from Student: an application is only a lead until staff
// contacts the family and creates the actual account.
model AdmissionApplication {
  id            String                @id @default(cuid())
  fullName      String
  phone         String
  childAge      Int
  parentFullName String?
  parentPhone    String?
  source        ApplicationSource     @default(WEBSITE)
  sourceDetails String?
  status        ApplicationStatus     @default(NEW)
  assignedToId  String?
  assignedTo    User?                 @relation("ApplicationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  nextCallAt    DateTime?
  lastContactAt DateTime?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  activities    ApplicationActivity[]

  @@index([createdAt])
  @@index([phone])
  @@index([parentPhone])
  @@index([source])
  @@index([assignedToId, status])
  @@index([nextCallAt])
}

model ApplicationActivity {
  id            String                  @id @default(cuid())
  applicationId String
  application   AdmissionApplication    @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  actorId       String
  actor         User                    @relation("ApplicationActivityActor", fields: [actorId], references: [id])
  type          ApplicationActivityType
  note          String?
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus?
  nextCallAt    DateTime?
  createdAt     DateTime                @default(now())

  @@index([applicationId, createdAt])
  @@index([actorId])
}
